{
  "name": "getimagepress",
  "version": "1.0.0",
  "description": "Free image tools - Convert HEIC, WebP, SVG, JPG, PNG and compress images to target sizes",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "node scripts/build-css.js",
    "build:pages": "node scripts/build-pages.js",
    "build": "npm run build:pages && npm run build:css"
  },
  "keywords": [
    "heic",
    "webp",
    "image",
    "convert",
    "compress",
    "image-tools"
  ],
  "author": "getIMAGEpress",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "sharp": "^0.33.0",
    "heic-convert": "^2.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
